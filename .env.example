# 복사해서 .env 로 쓰되, **API 키는 여기에 넣지 않는다**.
# 키는 Windows 사용자 환경변수(setx) 또는 컨테이너 env 로만 주입한다.
#   setx Studio_API_Key "up-..."   # Solar(Upstage) 앱 AI · 운영 기본
#   setx ANTHROPIC_API_KEY "sk-..."
#   setx GOOGLE_AI_API_KEY "AIza..."
# .env 계열은 .gitignore 에 있고, 로그에서는 마스킹된다.

# ── BFF (Node) ──
BFF_PORT=4000
KNOWLEDGE_URL=http://localhost:8000
LOG_LEVEL=info

# MOCK 우선 — 키 없이 전 흐름이 동작해야 한다. 키가 없으면 자동으로 mock.
AI_MOCK_MODE=true

# 앱 AI provider (운영 기본 = Solar/Upstage, OpenAI 호환). mock|solar|claude|gemini.
AI_PROVIDER=solar
SOLAR_BASE_URL=https://api.upstage.ai/v1
SOLAR_CHAT_MODEL=solar-pro3
# SOLAR_REASONING_EFFORT=low

# ── 지식 서비스 (Python) ──
PORT=8000
EMBEDDING_PROVIDER=mock      # mock | local | solar  (local 은 requirements-ml.txt 필요, solar 는 미구현)
LOCAL_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_DIM=384                # provider 를 바꾸면 차원이 달라진다 → knowledge/data/chroma 삭제 후 재기동
REASONER_TIMEOUT_S=60

# ── 프론트 ──
BFF_URL=http://localhost:4000
