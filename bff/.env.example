# API keys are NOT stored here. Set them as Windows user environment variables (setx):
#   Studio_API_Key (Solar/Upstage · 운영 기본), ANTHROPIC_API_KEY, GOOGLE_AI_API_KEY
# 운영: 아래 두 줄을 AI_MOCK_MODE=false + AI_PROVIDER=solar 로.
AI_MOCK_MODE=true
AI_PROVIDER=solar             # mock | solar | claude | gemini  (키없음/AI_MOCK_MODE→mock 폴백)
SOLAR_BASE_URL=https://api.upstage.ai/v1
SOLAR_CHAT_MODEL=solar-pro3
# SOLAR_REASONING_EFFORT=low  # 선택(미설정 시 모델 기본)
BFF_PORT=4000
KNOWLEDGE_URL=http://localhost:8000
